{
  "/higgsfield-ai/dop/turbo": {
    "summary": "Create higgsfield-ai dop turbo",
    "params": {
      "seed": {
        "type": "integer",
        "title": "Seed",
        "default": null,
        "maximum": 1000000,
        "minimum": 1
      },
      "prompt": {
        "type": "string",
        "title": "Prompt"
      },
      "motions": {
        "type": "array",
        "items": {
          "title": "Motion",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "description": "Motion preset ID."
            },
            "strength": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "multipleOf": 0.01,
              "description": "Strength of the selected motion preset."
            }
          },
          "required": [
            "id",
            "strength"
          ]
        },
        "title": "Motions",
        "default": null,
        "maxItems": 2,
        "minItems": 0
      },
      "image_url": {
        "type": "string",
        "title": "First frame image",
        "format": "uri"
      },
      "end_image_url": {
        "type": "string",
        "title": "Last frame image",
        "format": "uri"
      },
      "enhance_prompt": {
        "type": "boolean",
        "title": "Enhance Prompt",
        "default": true
      }
    },
    "required": [
      "prompt",
      "image_url"
    ]
  },
