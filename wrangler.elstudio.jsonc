{
  // elStudio como Worker de assets estáticos: sin `main`, sube `dist-elstudio/` tal cual.
  // `single-page-application` devuelve index.html en rutas como /proyectos/proyecto-1.
  // Se publica con `npm run elstudio:deploy:workers` (build + wrangler deploy -c este archivo).
  "name": "elstudio",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist-elstudio",
    "not_found_handling": "single-page-application"
  }
}
