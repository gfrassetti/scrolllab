{
  "name": "@scrolllab/embed",
  "version": "0.2.0",
  "description": "Embed a ScrollLab hosted section (or a pack of sections) with one tag. React, Next and Vue.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "types": "./react.d.ts",
  "typesVersions": {
    "*": {
      "vue": ["./vue.d.ts"]
    }
  },
  "exports": {
    ".": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./vue": {
      "types": "./vue.d.ts",
      "default": "./vue.js"
    }
  },
  "files": [
    "react.js",
    "react.d.ts",
    "vue.js",
    "vue.d.ts",
    "loader-client.js",
    "README.md"
  ],
  "peerDependencies": {
    "react": ">=17",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "vue": { "optional": true }
  },
  "homepage": "https://www.scrolllab.com.ar/lab",
  "keywords": [
    "scrolllab",
    "embed",
    "gsap",
    "scrollytelling",
    "iframe",
    "react",
    "vue"
  ]
}
