# Server
PORT=8787
NODE_ENV=development
CLIENT_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8787
SESSION_SECRET=change-me-in-production-scrolllab-min24
# STORE=file | mongo — en local sin Mongo usá file (default en development).
# En producción SOLO mongo (sin fallback). Si pedís mongo y no hay, en dev cae a file.
STORE=file
MONGODB_URI=mongodb://127.0.0.1:27017/scrolllab

# Cookies cross-origin (Railway front ≠ API): none + HTTPS
# COOKIE_SAME_SITE=none

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8787/api/auth/google/callback

# Solo desarrollo local — NUNCA en producción
AUTH_DEV_ENABLED=true

# Mercado Pago
# Con credenciales de la pestaña "Prueba", init_point ya abre el entorno de test.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Solo desarrollo — NUNCA en producción
MP_MOCK_ENABLED=true

# Email transaccional (Resend)
# 1) Creá API key en resend.com
# 2) Verificá tu dominio y usá una dirección de ese dominio en EMAIL_FROM
EMAIL_ENABLED=false
RESEND_API_KEY=
# Dominio verificado en Resend (DNS en Vercel o Cloudflare)
EMAIL_FROM=SCROLLLAB <compras@scrolllab.com.ar>
EMAIL_REPLY_TO=hola@scrolllab.com.ar
# URL pública absoluta (PNG preferible a SVG en clientes de mail)
EMAIL_LOGO_URL=https://www.scrolllab.com.ar/icon-192.png

# Formulario de contacto del home (Formspree → hola@scrolllab.com.ar)
# Override opcional; por defecto usa el form de producción.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/mrenneqe

DOWNLOAD_SECRET=change-me-download-secret-min24chars
# Link firmado efímero: se regenera en cada click, así compartirlo no sirve.
# La compra no caduca y las re-descargas desde Mis compras son ilimitadas.
DOWNLOAD_TTL_SECONDS=900
# 0 o vacío = sin tope (default). Poné un número solo para frenar abuso puntual.
MAX_DOWNLOADS=0
# Local. En Railway montá un volume y usá p.ej. /data/orders
STORAGE_DIR=./storage/orders

# --- Análisis de referencias (npm run analyze:ref) ---
# Opcional. Sin key: captura mecánica (beats + screenshots). Con key: Gemini anota fondo/figura/texto.
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- Cotización USD → ARS ---
# Los precios del catálogo están en dólares y se cobran en pesos: MP Argentina
# siempre procesa en moneda local. Fuente de la cotización (dólar blue venta).
FX_RATE_URL=https://dolarapi.com/v1/dolares/blue
# Margen sobre la cotización, en % (cubre el movimiento intradiario)
FX_SPREAD_PCT=0
# Respaldo si la API no responde. Actualizalo cada tanto.
FX_FALLBACK_RATE=1560
FX_CACHE_TTL_SECONDS=900
# true = nunca sale a la red, usa FX_FALLBACK_RATE (tests / offline)
FX_OFFLINE=false
