{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "scrolllab-omega.vercel.app" }],
      "destination": "https://www.scrolllab.com.ar/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://scrolllab-production.up.railway.app/api/:path*"
    },
    {
      "source": "/((?!assets/|v1/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/v1/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" }
      ]
    },
    {
      "source": "/v1/frame/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/v1/frame/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
