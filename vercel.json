{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "scrolllab-omega.vercel.app" }],
      "destination": "https://www.scrolllab.com.ar/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://scrolllab-production.up.railway.app/api/:path*"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
